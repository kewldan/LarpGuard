{
  "name": "larpguard-console",
  "version": "0.1.0",
  "private": true,
  "description": "LarpGuard web console: SPA and BFF over the bot-shield admin API and ClickHouse.",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "larpguard-console": "dist/server/main.js"
  },
  "scripts": {
    "dev:api": "node --watch-path=server --watch-path=shared server/dev/dev.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node dist/server/main.js",
    "tokens": "node scripts/gen-tokens.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:docker": "sh scripts/e2e-docker.sh"
  },
  "dependencies": {
    "@clickhouse/client": "1.24.1",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "fsevents": false
  }
}
