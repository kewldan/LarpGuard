[Unit]
Description=bot-shield bot filtering gateway
Documentation=file:///usr/share/doc/bot-shield/architecture.md
After=network-online.target
Wants=network-online.target

[Service]
# Ready once listening; WATCHDOG=1 only while every worker loop beats, so a
# stuck gateway is killed and restarted (the fail-open watchdog covers the
# time in between).
Type=notify
NotifyAccess=main
WatchdogSec=10
ExecStart=/usr/local/bin/bot-shield --config /etc/bot-shield/bot-shield.yaml
Restart=always
RestartSec=1
# Graceful drain (drain_timeout, 30s) plus a margin.
TimeoutStopSec=40
LimitNOFILE=1048576
# Root only to read acme.json (mode 0600); nothing else.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=bot-shield
StateDirectory=bot-shield

[Install]
WantedBy=multi-user.target
